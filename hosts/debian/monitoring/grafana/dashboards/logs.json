{
  "uid": "homeserver-logs",
  "title": "Logs (containers + journal)",
  "tags": ["logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "templating": {
    "list": [
      {"name": "container", "label": "Container", "type": "query", "datasource": {"type": "loki", "uid": "loki"},
       "query": {"label": "container", "stream": "", "type": 1}, "definition": "label_values(container)",
       "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}, "refresh": 2},
      {"name": "unit", "label": "Journal unit", "type": "query", "datasource": {"type": "loki", "uid": "loki"},
       "query": {"label": "unit", "stream": "", "type": 1}, "definition": "label_values(unit)",
       "includeAll": true, "allValue": ".*", "multi": true, "current": {"text": "All", "value": "$__all"}, "refresh": 2},
      {"name": "search", "label": "Text filter", "type": "textbox", "query": "", "current": {"text": "", "value": ""}}
    ]
  },
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Log volume by container", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 7},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "sum by (container) (count_over_time({source=\"docker\", container=~\"$container\"} [$__interval]))", "legendFormat": "{{container}}"}],
     "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}, "fillOpacity": 60}}, "overrides": []}},
    {"id": 2, "type": "timeseries", "title": "Errors + warnings (all sources)", "gridPos": {"x": 12, "y": 0, "w": 12, "h": 7},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "sum by (source) (count_over_time({source=~\"docker|journal\"} |~ \"(?i)(error|fail|warn|denied|panic|fatal)\" [$__interval]))", "legendFormat": "{{source}}"}],
     "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "stacking": {"mode": "normal"}, "fillOpacity": 60}}, "overrides": []}},
    {"id": 3, "type": "logs", "title": "Container logs", "gridPos": {"x": 0, "y": 7, "w": 24, "h": 12},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "{source=\"docker\", container=~\"$container\"} |~ \"(?i)$search\""}],
     "options": {"showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"}},
    {"id": 4, "type": "logs", "title": "System journal (sshd, sudo, kernel, tailscale, NetworkManager, docker...)", "gridPos": {"x": 0, "y": 19, "w": 24, "h": 12},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "{source=\"journal\", unit=~\"$unit\"} |~ \"(?i)$search\""}],
     "options": {"showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending"}}
  ]
}
