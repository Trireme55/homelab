[Unit]
Description=Rebuild the Jellyfin Live TV playlist and guide
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=homelab
Group=homelab
SupplementaryGroups=docker
Environment=HOME=/home/homelab
WorkingDirectory=/opt/homelab/hosts/debian/iptv
ExecStartPre=-/bin/rm -f /opt/homelab/hosts/debian/iptv/run/refresh.request
ExecStart=/usr/bin/python3 /opt/homelab/hosts/debian/iptv/refresh_pipeline.py
TimeoutStartSec=3600
Nice=10
